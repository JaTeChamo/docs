        <mxCell id="elf3aFCQr1T-KgwfLd_x-18" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;h1&gt;&lt;span&gt;Fluxo de chamada do próximo convidado&lt;/span&gt;&lt;/h1&gt;&lt;ol&gt;&lt;li&gt;&lt;div&gt;&lt;div&gt;&lt;p&gt;&lt;span&gt;Query no GSI1:&lt;/span&gt;&lt;/p&gt;&lt;div&gt;&lt;div&gt;&lt;pre dir=&quot;ltr&quot;&gt;&lt;code&gt;GSI1PK = QUEUE#queue-001#WAITING&#xa;ScanIndexForward = true&#xa;Limit = 1&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/li&gt;&lt;li&gt;&lt;div&gt;&lt;div&gt;&lt;p&gt;&lt;span&gt;Obter o primeiro convidado.&lt;/span&gt;&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;/li&gt;&lt;li&gt;&lt;div&gt;&lt;div&gt;&lt;p&gt;&lt;span&gt;Atualizar o convidado com uma condição:&lt;/span&gt;&lt;/p&gt;&lt;div&gt;&lt;div&gt;&lt;pre dir=&quot;ltr&quot;&gt;&lt;code&gt;ConditionExpression: status = WAITING&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/li&gt;&lt;li&gt;&lt;div&gt;&lt;div&gt;&lt;p&gt;&lt;span&gt;Atualizar:&lt;/span&gt;&lt;/p&gt;&lt;div&gt;&lt;div&gt;&lt;pre dir=&quot;ltr&quot;&gt;&lt;code&gt;status = CALLED&#xa;GSI1PK = QUEUE#queue-001#CALLED&#xa;GSI1SK = SEQ#000001&#xa;calledAt = ...&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/li&gt;&lt;/ol&gt;" vertex="1">
          <mxGeometry height="340" width="501" x="-1688" y="738" as="geometry" />
